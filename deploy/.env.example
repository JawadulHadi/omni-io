# ---- Required --------------------------------------------------------------
# Public hostname. Point its DNS A/AAAA record at this server; Caddy gets the
# HTTPS certificate on first start. Use `localhost` to try it on your machine.
DOMAIN=support.example.com

# openssl rand -hex 24   (one each — the app never sees the owner password)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=

# fake = offline demo answers; gemini = real answers (needs a key)
AI_PROVIDER=gemini
GEMINI_API_KEY=

# ---- Access ----------------------------------------------------------------
# false: only people with an invite link can create accounts.
ALLOW_SIGNUP=false
MAX_WORKSPACES_PER_USER=5

# Optional Google sign-in. Authorized redirect URI: https://<DOMAIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Cost ceilings -----------------------------------------------------------
TIER1_DAILY_LIMIT_PER_WORKSPACE=1000
ASK_LIMIT_PER_USER=30
INGEST_LIMIT_PER_WORKSPACE=60
WIDGET_LIMIT_PER_IP=20
WIDGET_LIMIT_PER_WORKSPACE=300

# ---- Data ------------------------------------------------------------------
# Days to keep customer questions in the answer audit (0 = forever).
ANSWER_RETENTION_DAYS=90
