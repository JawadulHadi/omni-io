# --- Database -------------------------------------------------------------
# The API and worker connect as omniio_app: not the table owner, not a
# superuser, NOBYPASSRLS — so row-level security actually applies.
DATABASE_URL=postgres://omniio_app:omniio_app@localhost:5432/omniio
# Migrations (npm run migrate) run as the schema owner. Never give this to the app.
DATABASE_MIGRATOR_URL=postgres://omniio:omniio@localhost:5432/omniio
REDIS_URL=redis://localhost:6379

# --- Auth -----------------------------------------------------------------
# At least 32 chars: `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
COOKIE_SECURE=false                     # true behind HTTPS
CONSOLE_ORIGIN=http://localhost:5173    # comma-separated allow-list for CORS + redirects
TRUST_PROXY=0                           # number of proxy hops in front of the API (for per-IP rate limits)

# Optional Google sign-in (leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback

# --- AI provider ----------------------------------------------------------
# fake   = deterministic offline provider (tests, local dev, ladder demos)
# gemini = Google Gemini for Tier 1 answers + embeddings (768 dims)
AI_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
TIER1_TIMEOUT_MS=8000

# --- Widget rate limits (requests per minute) ------------------------------
WIDGET_LIMIT_PER_IP=20
WIDGET_LIMIT_PER_WORKSPACE=300

# --- Storage & secrets ----------------------------------------------------
STORAGE_DIR=./storage
# base64 of 32 random bytes: `openssl rand -base64 32`
APP_USER_CONNECTION_KEY_SECRET=

PORT=3000
