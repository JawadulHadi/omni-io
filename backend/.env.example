# --- Database -------------------------------------------------------------
# The API and worker connect as omniio_app: not the table owner, not a
# superuser, NOBYPASSRLS — so row-level security actually applies.
DATABASE_URL=postgres://omniio_app:omniio_app@localhost:5432/omniio
# Migrations (npm run migrate) run as the schema owner. Never give this to the app.
DATABASE_MIGRATOR_URL=postgres://omniio:omniio@localhost:5432/omniio
REDIS_URL=redis://localhost:6379
DB_STATEMENT_TIMEOUT_MS=30000

# --- Auth -----------------------------------------------------------------
# At least 32 chars: `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
COOKIE_SECURE=false                     # true behind HTTPS
CONSOLE_ORIGIN=http://localhost:5173    # comma-separated allow-list for CORS + redirects
TRUST_PROXY=0                           # number of proxy hops in front of the API (for per-IP rate limits)
ALLOW_SIGNUP=true                       # false: only invite links create accounts
MAX_WORKSPACES_PER_USER=5

# Optional Google sign-in (leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback

# --- AI provider ----------------------------------------------------------
# fake   = deterministic offline provider (tests, local dev, ladder demos)
# gemini = Google Gemini for Tier 1 answers + embeddings (768 dims)
AI_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
TIER1_TIMEOUT_MS=8000
RETRIEVAL_TIMEOUT_MS=4000               # query embedding + vector search
TIER1_MIN_GROUNDING=0.2                 # share of answer words found in its citations; 0 disables

# --- Cost ceilings ----------------------------------------------------------
TIER1_DAILY_LIMIT_PER_WORKSPACE=1000    # model calls per workspace per day; then Tier 2
ASK_LIMIT_PER_USER=30                   # questions per user per minute (console + MCP)
INGEST_LIMIT_PER_WORKSPACE=60           # documents per workspace per hour
WIDGET_LIMIT_PER_IP=20                  # widget requests per IP per minute
WIDGET_LIMIT_PER_WORKSPACE=300          # widget questions per workspace per minute

# --- Storage & retention ------------------------------------------------------
STORAGE_DRIVER=none                     # none: keep extracted text only; local: also keep originals in STORAGE_DIR
STORAGE_DIR=./storage                   # with local: ONE volume shared by every API and worker process
ANSWER_RETENTION_DAYS=90                # days to keep customer questions in the audit; 0 = forever

PORT=3000
